# Sourced by scripts/slurm/*.slurm on the compute node (JV_SITE_ENV=/path/to/site.env). Copy to site.env (not
# committed) and fill in. Paths only: secrets stay in each tool's own login file (HF_HOME/token, AWS credentials).

# Software: modules and the virtual environment that has jevarena-mm with the model's extra installed.
# module load python/3.12.11                      # e.g. where the system python3 is older than 3.11
# source /path/to/venv/bin/activate
# Models need different software: a latency plan names it per model (env), and latency.slurm passes it as JV_ENV
# (docs/latency.md, Environments), e.g.
# case ${JV_ENV:-jev} in
#   jev) source /path/to/venv-jev/bin/activate;;   # also: module load apptainer; export XOR_SIF=/path/to/xor.sif
#   vllm) source /path/to/venv-vllm/bin/activate; module load cuda/12.8; export CXX=g++;;   # nvcc, a C++20 compiler
#   vllm031) source /path/to/venv-vllm031/bin/activate; module load cuda/12.8;;
#   d3) source /path/to/venv-d3/bin/activate;;
# esac

# Data and caches: run from a scratch file system, not a backed-up or shared home.
# export JEVARENA_MM_MEDIA=/path/to/media
# export JEVARENA_MM_RUNS=/path/to/runs           # default: results/runs/ in the checkout
# export JEVARENA_MM_ATTEMPTS=/path/to/attempts   # episode files, ~200 per episode: not under a file-count quota
# export HF_HOME=/path/to/hf_home                 # holds the token written by `hf auth login`
# export HF_HUB_CACHE=/path/to/hf_cache           # model weights, fetched before the array (HF_HUB_OFFLINE=1 in jobs)

# A machine of one's own instead of an exclusive Slurm node (scripts/slurm/latency_local.py runs a plan there;
# results/summary/latency/h100-sxm/). Each of these changed latencies on a shared 8x H100 SXM VM:
# export TORCH_CUDNN_SDPA_DEPRIORITIZED=1    # H100: SDPA's cuDNN kernel builds a plan per new sequence length (~0.5 s)
# export OMP_NUM_THREADS_LATENCY=16          # all cores (the default) cost every request extra when others hold cores
# case ${JV_SPEC:-} in *Phi-4-multimodal*) export OMP_NUM_THREADS_LATENCY=unset ;; esac   # else its engine hangs at start
# export NCCL_NVLS_ENABLE=0                  # where NVLink SHARP multicast fails, every tp=2 engine dies at start
# export APPTAINER_BIND=/path/to/workspace   # Xor: when XOR_CACHE or TMPDIR are outside Apptainer's default binds

# Memory: decoded frames are large arrays (a 1080p frame is ~6 MB). glibc's default raises its mmap threshold after the
# first large free, so later frames come from the decode threads' heap arenas and are kept: a shard that decodes long
# videos grew to 60-100 GB. A fixed threshold maps every large array and gives it back when freed (6-14 GB per shard).
export MALLOC_MMAP_THRESHOLD_=1048576 MALLOC_ARENA_MAX=4
