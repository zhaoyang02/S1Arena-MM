# Copy to .env (never committed). Every value can also be set in the environment.

# Media root (default: media/ in the repository)
# JEVARENA_MM_MEDIA=/path/to/media

# Prepared audio delivery (local only); see docs/audio.md
# JEVARENA_AUDIO_DATA=/path/to/delivery
# GEMINI_API_KEY=

# Raw model responses (default: results/runs/ in the repository)
# JEVARENA_MM_RUNS=/path/to/runs

# Closed-loop episode attempts: every request and reply, the upstream logs (hundreds of files per episode; default:
# results/episodes/ next to the episode rows). On a cluster, a file system without a file-count quota
# JEVARENA_MM_ATTEMPTS=/path/to/attempts

# Hugging Face (only for `fetch` of gated sources and for publishing releases)
# HF_TOKEN=

# Local Jev models
# ONEJEV_ENGINE_DIR=/path/to/qev            # official engine checkout
# ONEJEV_MODEL_DIR=/path/to/OneJev
# JEV_OMNI_MODEL_DIR=/path/to/Jev-Omni

# Closed-loop suites, played through jevarena_mm/bridges/ (checkout + that suite's own Python)
# JEVARENA_MM_GAMEWORLD=/path/to/GameWorld
# JEVARENA_MM_GAMEWORLD_PYTHON=/path/to/gameworld-venv/bin/python
# JEVARENA_MM_GAMEWORLD_BROWSERS=/path/to/playwright-browsers
# JEVARENA_MM_BALROG=/path/to/BALROG
# JEVARENA_MM_BALROG_PYTHON=/path/to/balrog-venv/bin/python
# JEVARENA_MM_VSBENCH=/path/to/VS-Bench
# JEVARENA_MM_VSBENCH_PYTHON=/path/to/vsbench-venv/bin/python
